# Local development owner credentials support Alembic and test cleanup only.
# In production, migrate separately and run the app as a non-owner least-privilege role.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rbac_example
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rbac_example_test
REDIS_URL=redis://127.0.0.1:6379/0
# Keep high-cardinality rate-limit and verification state away from active JTI
# records in production. A small project may explicitly point both URLs at the
# same Redis after accepting the shared-failure risk.
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380/0
# Required with no application default. Keep this explicit in every deployment;
# use a real deployment name such as production or staging outside local work.
APP_ENVIRONMENT=development
SERVICE_NAME=fastapi-postgresql-rbac-example
# Set this from the deployed build or immutable source revision.
SERVICE_VERSION=unreleased
LOG_LEVEL=INFO
# Keep false in production unless traceback handling and log access were reviewed.
LOG_INCLUDE_EXCEPTION_DETAILS=false
# Generate a unique value before startup: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-this-with-at-least-32-random-bytes
# Generate a different value with the same secrets.token_urlsafe(32) command.
# It protects Redis limiter identities, not JWT signatures.
RATE_LIMIT_HMAC_KEY=replace-this-with-a-rate-limit-hmac-secret
# Public registration is a product decision. Keep it hidden unless the owner
# explicitly chooses self-service sign-up and accepts the registration quotas.
PUBLIC_REGISTRATION_ENABLED=false
# Verification is optional. Leave it disabled for username/password-only sites.
VERIFICATION_ENABLED=false
# When enabling it, provide a third distinct secret and explicitly select only
# the purposes, channels, and delivery adapters implemented by the product.
# VERIFICATION_CODE_HMAC_KEY=replace-this-with-a-verification-hmac-secret
# VERIFICATION_ENABLED_PURPOSES=registration,login,password_reset
# VERIFICATION_ENABLED_CHANNELS=email,sms
# Optional pair. Enable only after the user explicitly approves issuer/audience
# scoping for this product; otherwise leave both unset.
# JWT_ISSUER=https://identity.example.test
# JWT_AUDIENCE=fastapi-rbac-example
# Default is one hour. Choose a lifetime that fits the product's risk and UX.
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
# Keep enabled outside explicit local/test runs. Startup rejects false for every
# environment except dev/development/local/test/testing because it would bypass
# API admission and the login/registration IdentityAbuseFlow.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_NAMESPACE=fastapi_rbac
# Starting values only. Show them to the product owner before implementation and
# let them accept or adjust them for real traffic, shared NATs, and automation.
RATE_LIMIT_GLOBAL_PER_MINUTE=6000
RATE_LIMIT_GLOBAL_BURST=1000
RATE_LIMIT_API_IP_PER_MINUTE=1200
RATE_LIMIT_API_IP_BURST=200
RATE_LIMIT_ANONYMOUS_READ_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATED_READ_PER_MINUTE=300
RATE_LIMIT_MANAGEMENT_READ_PER_MINUTE=120
RATE_LIMIT_ORDINARY_WRITE_PER_MINUTE=60
RATE_LIMIT_AUTHORIZATION_WRITE_PER_MINUTE=30
RATE_LIMIT_SUPER_ADMIN_TRANSFER_PER_HOUR=3
RATE_LIMIT_LOGOUT_ALL_PER_TEN_MINUTES=5
RATE_LIMIT_LOGIN_IP_PER_FIVE_MINUTES=20
RATE_LIMIT_LOGIN_PAIR_PER_FIFTEEN_MINUTES=5
RATE_LIMIT_LOGIN_GLOBAL_PER_FIVE_MINUTES=1000
RATE_LIMIT_LOGIN_GLOBAL_BURST=200
RATE_LIMIT_REGISTRATION_IP_PER_HOUR=5
RATE_LIMIT_REGISTRATION_TARGET_PER_HOUR=3
RATE_LIMIT_REGISTRATION_PAIR_PER_HOUR=3
RATE_LIMIT_REGISTRATION_GLOBAL_PER_HOUR=500
RATE_LIMIT_REGISTRATION_GLOBAL_BURST=100
# An invalid password increments a private account risk signal, but that signal
# never blocks a correct password before verification. It expires automatically.
LOGIN_FAILURE_STATE_RETENTION_SECONDS=86400
# Optional verification defaults. Uncomment only after VERIFICATION_ENABLED=true
# and after the product owner accepts or changes the complete default table.
# RATE_LIMIT_VERIFICATION_TARGET_AVERAGE_PER_DAY=5
# RATE_LIMIT_VERIFICATION_IP_PER_HOUR=20
# RATE_LIMIT_VERIFICATION_PAIR_PER_HOUR=5
# RATE_LIMIT_VERIFICATION_GLOBAL_PER_MINUTE=300
# RATE_LIMIT_VERIFICATION_GLOBAL_BURST=50
# RATE_LIMIT_VERIFICATION_CHANNEL_PER_MINUTE=200
# RATE_LIMIT_VERIFICATION_CHANNEL_BURST=40
# RATE_LIMIT_VERIFICATION_SUBMIT_IP_PER_HOUR=120
# RATE_LIMIT_VERIFICATION_SUBMIT_TARGET_PER_HOUR=20
# RATE_LIMIT_VERIFICATION_SUBMIT_PAIR_PER_HOUR=10
# RATE_LIMIT_VERIFICATION_SUBMIT_GLOBAL_PER_MINUTE=3000
# RATE_LIMIT_VERIFICATION_SUBMIT_GLOBAL_BURST=500
# VERIFICATION_SEND_COOLDOWN_SECONDS=60
# VERIFICATION_CODE_TTL_SECONDS=300
# VERIFICATION_CODE_LENGTH=6
# VERIFICATION_MAX_ATTEMPTS=5
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
SQL_ECHO=false
