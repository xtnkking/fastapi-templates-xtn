# Local development owner credentials support Alembic and test cleanup only.
# In production, migrate separately and run the app as a non-owner least-privilege role.
# Default: one standalone PostgreSQL instance; localhost is a development example.
# Only if a cluster is requested, use its operations-provided writable endpoint.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rbac_example
# Per application process. Budget instances * workers * (pool size + overflow),
# leaving room for migrations, operators and other services on PostgreSQL.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Client-side deadline for a driver command or checkout probe, including when
# an established connection stops receiving replies. A request can run several
# commands. Timed-out connections are discarded; writes are never replayed.
DATABASE_COMMAND_TIMEOUT_SECONDS=20
# Milliseconds; lock timeout must not exceed statement timeout. These defaults
# are for ordinary API requests, not migrations or long-running offline reports.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rbac_example_test
# Default: one standalone Redis instance for login state, CAPTCHA, and quotas.
# Only if native Sentinel/Cluster is requested, replace REDIS_URL with
# REDIS_CONNECTION__MODE/NODES.
# See ../../references/redis-connections.md for three short connection examples,
# separate Sentinel credentials, TLS, and the exact optional field names.
REDIS_URL=redis://127.0.0.1:6379/0
# Optional: uncomment only when a separate rate-limit Redis is requested.
# Otherwise its client inherits REDIS_URL (or the complete selected connection).
# CAPTCHA always uses the main Redis. Do not assign an empty override URL.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380/0
# Required with no application default. Keep this explicit in every deployment;
# use a real deployment name such as production or staging outside local work.
APP_ENVIRONMENT=development
SERVICE_NAME=fastapi-postgresql-rbac-example
# Set this from the deployed build or immutable source revision.
SERVICE_VERSION=unreleased
LOG_LEVEL=INFO
# Keep false in production unless traceback handling and log access were reviewed.
LOG_INCLUDE_EXCEPTION_DETAILS=false
# Per-process operational log buffer. Full/oversized records are dropped, never
# awaited by requests. Database audits remain transactional and do not use it.
LOG_QUEUE_CAPACITY=1000
LOG_SHUTDOWN_TIMEOUT_SECONDS=2
# Generate a unique value before startup: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-this-with-at-least-32-random-bytes
# Generate a different value with the same secrets.token_urlsafe(32) command.
# It protects Redis limiter identities, not JWT signatures.
RATE_LIMIT_HMAC_KEY=replace-this-with-a-rate-limit-hmac-secret
# Registration is enabled in the database initially. Only super_admin may
# change its persistent switch after bootstrap; there is no environment bypass.
# Optional pair. Enable only after the user explicitly approves issuer/audience
# scoping for this product; otherwise leave both unset.
# JWT_ISSUER=https://identity.example.test
# JWT_AUDIENCE=fastapi-rbac-example
# Default is 24 hours. Shorten it for high-risk or administrative surfaces.
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
# Project decision: replace this example number after asking how many simultaneous
# active logins each user may have. These are logins, not physical devices.
MAX_ACTIVE_SESSIONS_PER_USER=2
# Project choice for administrator password reset:
# direct (default) sets a permanent password immediately; temporary requires the
# user to complete one formal-password setup before login can issue a Token.
ADMIN_PASSWORD_RESET_MODE=direct
# Keep enabled outside explicit local/test runs. Startup rejects false for every
# environment except dev/development/local/test/testing because it would bypass
# API admission and the login/registration IdentityAbuseFlow.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_NAMESPACE=fastapi_rbac
# Starting values only. Show them to the product owner before implementation and
# let them accept or adjust them for real traffic, shared NATs, and automation.
RATE_LIMIT_CAPTCHA_CREATE_PER_FIVE_MINUTES=10
RATE_LIMIT_AUTHENTICATED_READ_PER_MINUTE=600
RATE_LIMIT_MANAGEMENT_READ_PER_MINUTE=300
RATE_LIMIT_ORDINARY_WRITE_PER_MINUTE=120
RATE_LIMIT_AUTHORIZATION_WRITE_PER_MINUTE=60
RATE_LIMIT_LOGIN_IP_PER_FIVE_MINUTES=20
RATE_LIMIT_TEMPORARY_COMPLETE_IP_PER_FIVE_MINUTES=20
RATE_LIMIT_REGISTRATION_IP_PER_HOUR=5
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# Per process and client; Cluster uses this cap PER NODE, not for the whole
# cluster. Sentinel discovery connections also own bounded pools.
REDIS_MAX_CONNECTIONS=50
# Maximum time allowed for each dependency check in /health/ready.
READINESS_TIMEOUT_SECONDS=1.0
SQL_ECHO=false
