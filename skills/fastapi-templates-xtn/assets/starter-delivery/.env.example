# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
# FastAPI 的应用显示名称和版本号，不写入日志。
SERVICE_NAME={{PROJECT_NAME}}
SERVICE_VERSION=0.1.0
# 单个 HTTP 请求体最大字节数，1048576 表示 1 MiB。
REQUEST_BODY_MAX_BYTES=1048576

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
# 异步连接地址；默认连接单机或运维提供的统一入口。
DATABASE_URL=postgresql+asyncpg://replace_user:replace_password@127.0.0.1:5432/replace_database
# 连接池常驻数、临时扩容数和等待空闲连接的秒数。
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
# 建连、单条命令、SQL 执行和数据库锁的超时；后两项单位为毫秒。
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
# 是否打印 SQL；正式环境建议 false。
SQL_ECHO=false

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# 只提供单机 Redis；登录状态、验证码和限流默认共用此地址。
REDIS_URL=redis://127.0.0.1:6379/0
# 最大连接数、建连超时和读写超时；超时单位为秒。
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=0.5

# ------------------------------------------------------------
# 日志
# 日志同时写控制台和项目根目录 logs/北京时间日期/app.log，首次写入自动创建。
# INFO 包含正常请求；WARNING/ERROR 会过滤正常请求。保存位置在 output.py 的 LOG_ROOT_DIR 修改。
# 是否记录安全的异常类型和代码位置；不会输出异常原文、密码或 Token。
LOG_LEVEL=INFO
LOG_INCLUDE_EXCEPTION_DETAILS=false
# 单个日志文件最大 MB 数，1 MB = 1024 × 1024 字节；必须为正整数，修改后重启。
# 文件放不下下一条时切换到当天 app.1.log、app.2.log 等；旧日志继续保留。
LOG_FILE_MAX_MB=100
# 日志密码指纹专用密钥，至少 32 个随机字节；不能与 JWT_SECRET 或 RATE_LIMIT_HMAC_KEY 相同。
# 只用于比对设置新密码请求是否提交了相同密码，不记录密码原文；更换密钥后指纹也改变。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LOG_HMAC_KEY=replace-this-with-a-log-hmac-secret

# ------------------------------------------------------------
# JWT 与登录会话
# ------------------------------------------------------------
# 两项密钥必须分别生成且至少 32 个随机字节，不能使用示例值。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-this-with-at-least-32-random-bytes
RATE_LIMIT_HMAC_KEY=replace-this-with-a-rate-limit-hmac-secret
# iss/aud 只有在使用者明确同意后才成对启用。
# JWT_ISSUER=https://identity.example.test
# JWT_AUDIENCE={{PROJECT_NAME}}
# Token 有效秒数和每个用户最大同时登录数。
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
MAX_ACTIVE_SESSIONS_PER_USER={{MAX_SESSIONS}}

# ------------------------------------------------------------
# 业务限流
# ------------------------------------------------------------
# 修改下面的次数后重启服务生效；窗口秒数在 app/dependencies/rate_limit.py 中。
# 请求进入正式计数步骤就占用一次，业务失败不返还；不是只统计成功操作。

# 通用连接
# 默认复用 REDIS_URL；需要独立的限流 Redis 时才填写下面的地址。
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380/0

# 登录提交（不要求先登录）
# 每个来源 IP，每 5 分钟最多提交 20 次登录；换用户名仍累计，验证码或密码错误也计次。
RATE_LIMIT_LOGIN_IP_PER_FIVE_MINUTES=20

# 注册提交（不要求先登录）
# 每个来源 IP，每小时最多提交 5 次注册请求；不是成功注册 5 个账号，与登录分别计数。
RATE_LIMIT_REGISTER_IP_PER_HOUR=5

# 验证码领取
# 每种用途分别计数，每 5 分钟最多申请 10 次；只限制领图片，不代替后续业务提交限流。
# 未登录：登录、注册用途 + 来源 IP；已登录：新增用户、重置密码、本人改密用途 + 操作者 ID。
RATE_LIMIT_CAPTCHA_CREATE_PER_FIVE_MINUTES=10

# 普通用户接口（已登录）：包括本人接口、默认的权限接口，按具体接口 + 当前用户 ID 分别计数。
# 普通 GET 查询：固定 60 秒窗口，最多 600 次，例如读取自己的资料、权限。
RATE_LIMIT_USER_READ=600
# 普通 POST 操作：固定 60 秒窗口，最多 120 次，例如本人改密。
RATE_LIMIT_USER_WRITE=120

# 管理业务：只有 require_permission(..., management=True) 才选择下面两项。
# 有接口权限不代表是管理员；不按角色或是否检查权限自动选择，仍按具体接口 + 当前用户 ID 计数。
# 管理 GET 查询：固定 60 秒窗口，最多 300 次，例如用户、角色、权限列表及详情。
RATE_LIMIT_ADMIN_READ=300
# 管理 POST 修改：固定 60 秒窗口，最多 60 次，例如新增用户、重置密码、角色授权。
RATE_LIMIT_ADMIN_WRITE=60
